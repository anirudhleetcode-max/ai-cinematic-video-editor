  "techniques": [
    "procedural fireball (noise + radial density + temperature ramp)",
    "lit smoke billow",
    "shockwave ring + displacement",
    "ballistic debris (dark chunks + burning streaks)",
    "zoom-blur arrival",
    "fly-through exit"
  ],
  "design": {
    "entrance": "A short charged beat (ignition point flickering in the dark), then the blast hurls the title forward out of the fireball core with zoom blur.",
    "reveal": "Expanding fireball cooling into billowing lit smoke, a fast shockwave ring with refraction, ballistic debris and embers - all behind/around the title, never permanently over it.",
    "camera": "Locked-off, heavy concussive shake on detonation, then a very slow settle-in push.",
    "material": "Pale blast-worn concrete/steel plate, flat chamfer, fire rim light from behind, hard drop shadow on the smoke.",
    "exit": "The title rushes past camera (fly-through with zoom blur) as the smoke closes in."
  },
  "fusion_notes": [
    "Debris on/off: set Particle Intensity to 0 to disable all debris and embers (DebrisEmitter/EmberEmitter Number = count x ParticleIntensity); values between 0 and 2 scale the amount.",
    "Explosion strength: Impact Intensity scales fireball size and brightness, the flash, both shockwave rings and the shockwave refraction (0 = title arrives without the blast).",
    "The fireball is FastNoise inside an expanding soft EllipseMask; to re-centre the blast move FireballShape, FireCoreShape, SmokeShape, ShockRingA/B Shape centres together."
  ],
