# Cutroom configuration. Copy to .env. Every value has a safe default for local development;
# with EDITOR_ENV=production the server REFUSES to start on unsafe settings (see docs/DEPLOYMENT.md).

# ---- environment / process role ---------------------------------------------------------------
# development | production
EDITOR_ENV=development
# all (API + workers in one process) | api (HTTP only) | worker (jobs only: python -m editor.worker)
EDITOR_ROLE=all
# Concurrent jobs per worker process
EDITOR_WORKERS=1
# EDITOR_ANALYSIS_THREADS=3
# Attempts per job when a worker dies mid-job (stale heartbeat -> re-queued)
EDITOR_JOB_MAX_ATTEMPTS=2

# ---- storage ----------------------------------------------------------------------------------
# Projects, cache, renders and the SQLite DB. Shared by API and worker (same volume).
# EDITOR_DATA_DIR=./data
# Optional ONNX models (scripts/download_models.py); default <data>/models
# EDITOR_MODELS_DIR=./data/models
EDITOR_MAX_UPLOAD_MB=4096
EDITOR_USER_QUOTA_GB=50
EDITOR_RETENTION_DAYS=30
# 1 = periodic cleanup of expired renders / temp files in this process
EDITOR_CLEANUP=1

# ---- FFmpeg -----------------------------------------------------------------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Kill any single FFmpeg/ffprobe process after this many seconds
EDITOR_PROCESS_TIMEOUT=7200
EDITOR_QC_MAX_RETRIES=2

# ---- accounts and security ----------------------------------------------------------------------
# token (accounts + API tokens; required in production) | none (single local user; development only)
# EDITOR_AUTH=token
# 1 = anyone can create an account in the web app; 0 = administrator creates users (python -m editor.auth create-user)
EDITOR_ALLOW_REGISTRATION=1
EDITOR_SESSION_DAYS=14
# Comma-separated web origins allowed to call the API (https:// in production; never *)
EDITOR_CORS_ORIGINS=http://localhost:3000
EDITOR_RATE_LIMIT_PER_MIN=240
EDITOR_UPLOAD_RATE_PER_MIN=120
EDITOR_JOB_RATE_PER_MIN=20
EDITOR_LOGIN_RATE_PER_MIN=10
EDITOR_MAX_JOBS_PER_USER=3
EDITOR_MAX_PROJECTS_PER_USER=50

# ---- optional AI provider (the deterministic director works without any of these) ----------------
# auto | deterministic | claude | openai_compatible | local
EDITOR_AI_PROVIDER=auto
# Server-side only. Never put an API key in a NEXT_PUBLIC_* variable.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible server (e.g. Ollama)
# OPENAI_API_KEY=
# OPENAI_MODEL=llama3.1
# opencv = force the classic detectors even when the ONNX models are installed
# EDITOR_VISION=auto

# ---- optional offline speech-to-text for automatic captions ------------------------------------
# EDITOR_STT_MODEL_DIR=./data/models/sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8

# ---- web app (compiled into the browser bundle: public values only) -----------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
